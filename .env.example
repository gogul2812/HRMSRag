# =============================================================================
# RAG Platform - Environment Variable Template
# Copy to .env and replace CHANGE_ME values.
# Encoding: save as UTF-8 WITHOUT BOM (setup_local.ps1 does this for you).
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (Windows local uses host port 15432 via docker-compose.override.yml)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=ragplatform
POSTGRES_USER=raguser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql+asyncpg://raguser:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:15432/ragplatform
DATABASE_URL_SYNC=postgresql://raguser:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:15432/ragplatform

# -----------------------------------------------------------------------------
# Redis (Windows local host port 16379)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16379/0
# 1 = index documents inside the API process (required for local without a Celery worker)
CELERY_TASK_ALWAYS_EAGER=1

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
AUTH_BACKEND=jwt_local
SETUP_TOKEN=local-setup-token

# -----------------------------------------------------------------------------
# Object Storage (optional S3; local disk is default)
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://YOUR_R2_ACCOUNT.r2.cloudflarestorage.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=rag-platform-documents
S3_REGION=auto

# -----------------------------------------------------------------------------
# LLM Providers (Groq -> Gemini -> OpenRouter -> Ollama)
# Do NOT wrap keys in quotes.
# -----------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b
LLM_DEFAULT_MODEL=groq/llama-3.3-70b-versatile
LLM_ROUTER_MODE=litellm
CHAT_FAKE_ORCHESTRATOR=0

# -----------------------------------------------------------------------------
# Embedding and reranking
# Local demo: fake is fine. Production: use BGE models below.
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=fake
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_NAME=fake
RERANKER_DEVICE=cpu
# Production examples:
# EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Guardrails / PII
# -----------------------------------------------------------------------------
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002
GUARDRAILS_CONFIG_DIR=/app/guardrails_config
PII_SCRUB_MODE=regex

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rag-platform
OTEL_SDK_DISABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Service ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ADMIN_CONFIG_SERVICE_PORT=8002
INGESTION_SERVICE_PORT=8003
RETRIEVAL_SERVICE_PORT=8004
LLM_ORCHESTRATOR_SERVICE_PORT=8005
CHAT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Application
# Use APP_DEBUG (not DEBUG). Windows often has DEBUG=release which breaks bool parsing.
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

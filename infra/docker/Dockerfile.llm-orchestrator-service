FROM python:3.11-slim-bookworm

WORKDIR /app
RUN useradd -m -s /bin/bash appuser

COPY shared-libs/schemas /shared-libs/schemas
COPY shared-libs/auth-middleware /shared-libs/auth-middleware
COPY shared-libs/observability /shared-libs/observability
COPY shared-libs/pii /shared-libs/pii
COPY ai-core/llm_router /ai-core/llm_router
COPY services/llm-orchestrator-service/pyproject.toml /app/pyproject.toml
COPY services/llm-orchestrator-service/app /app/app

RUN pip install --no-cache-dir \
    -e /shared-libs/schemas \
    -e /shared-libs/auth-middleware \
    -e /shared-libs/observability \
    -e /shared-libs/pii \
    -e /ai-core/llm_router \
    && pip install --no-cache-dir \
    "fastapi>=0.110.0,<1.0.0" \
    "uvicorn[standard]>=0.29.0" \
    "httpx>=0.27.0" \
    "sse-starlette>=2.0.0" \
    "pydantic-settings>=2.3,<3" \
    "python-jose[cryptography]>=3.3.0"

USER appuser
EXPOSE 8005
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8005"]

FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash appuser

COPY shared-libs/schemas /shared-libs/schemas
COPY shared-libs/auth-middleware /shared-libs/auth-middleware
COPY shared-libs/observability /shared-libs/observability
COPY ai-core/parsing /ai-core/parsing
COPY ai-core/chunking /ai-core/chunking
COPY ai-core/embedding /ai-core/embedding
COPY services/ingestion-service/pyproject.toml /app/pyproject.toml
COPY services/ingestion-service/app /app/app

RUN pip install --no-cache-dir \
    -e /shared-libs/schemas \
    -e /shared-libs/auth-middleware \
    -e /shared-libs/observability \
    -e "/ai-core/parsing[docling]" \
    -e /ai-core/chunking \
    -e "/ai-core/embedding[model]" \
    && pip install --no-cache-dir \
    "fastapi>=0.110.0,<1.0.0" \
    "uvicorn[standard]>=0.29.0" \
    "python-multipart>=0.0.9" \
    "sqlalchemy[asyncio]>=2.0.28" \
    "asyncpg>=0.29.0" \
    "psycopg2-binary>=2.9.9" \
    "celery[redis]>=5.3.0" \
    "redis>=5.0.3" \
    "qdrant-client>=1.9.0" \
    "pydantic-settings>=2.3,<3" \
    "python-jose[cryptography]>=3.3.0" \
    "llama-index-core>=0.10.0" \
    "pypdf>=4.0.0" \
    "Pillow>=10.0.0" \
    "pytesseract>=0.3.10"

USER appuser
# Default: API. Override command for worker:
# celery -A app.worker.celery_app worker --loglevel=info
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003"]

# =============================================================================
# RAG Platform — .gitignore
# =============================================================================

# Environment / secrets — NEVER commit
.env
*.env.local
*.env.production
*.env.staging
secrets/

# Environment backups (may contain real secrets — NEVER commit)
*.bak
.env.bad.bak
.env.*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/
.env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml
test-results/

# Ruff cache
.ruff_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Node.js / Next.js
node_modules/
.next/
out/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Docker volumes (local bind mounts — not checked in)
data/postgres/pgdata/
data/redis/redisdata/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Model weights (large binary files — store elsewhere)
*.bin
*.safetensors
*.gguf
models/

# Large data files — keep generated/bulk data out of git.
# Note: already-tracked files (package-lock.json, eval results, datasets)
# remain tracked; this only prevents new files matching these patterns.
*.csv
*.json
*.db
*.sqlite
*.sqlite3
*.parquet
*.h5
*.hdf5
*.npz
*.arrow

# Local run / verify artifacts
logs/
test_output.log
test_output.txt

# Alembic auto-generated (keep the versions folder, not __pycache__)
data/postgres/alembic/__pycache__/

# Qdrant local storage (managed by Docker volume, not git)
data/qdrant/storage/
